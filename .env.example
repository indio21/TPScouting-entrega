# Copiar como .env solo para completar valores. La aplicacion no carga este
# archivo automaticamente. Docker puede leerlo mediante: --env-file .env

# Obligatorio en produccion. Generar un valor aleatorio; no reutilizar este texto.
APP_SECRET_KEY=CAMBIAR_POR_UN_SECRETO_ALEATORIO

# PostgreSQL recomendado para un despliegue persistente.
APP_DB_URL=postgresql+psycopg://usuario:password@host:5432/tpscouting
TRAINING_DB_URL=postgresql+psycopg://usuario:password@host:5432/tpscouting

ENV=production
LOG_LEVEL=INFO
PORT=8000

# Mantener deshabilitado en produccion web. El entrenamiento es una operacion
# offline y los artefactos solo deben provenir de fuentes confiables.
AUTO_TRAIN_ON_STARTUP=0
SYNC_SHORTLIST_ENABLED=0

# La carga demo genera exclusivamente datos sinteticos. Deshabilitarla si una
# institucion autoriza en el futuro un entorno separado para datos reales.
DEMO_SEED_ON_STARTUP=1
DEMO_SEED_PLAYERS=60
DEMO_SEED=42

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_POR_UNA_PASSWORD_FUERTE
ALLOW_DEFAULT_ADMIN=false

PLAYER_LIST_PER_PAGE=50
MAX_COMPARE_PLAYERS=2000
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=128
EVAL_POOL_MAX=100
ENFORCE_EVAL_POOL_LIMIT=1

LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
MAX_CONTENT_LENGTH=2097152
PIPELINE_LOCK_STALE_SECONDS=43200

POTENTIAL_MEDIUM_THRESHOLD=0.60
POTENTIAL_HIGH_THRESHOLD=0.80
POT_W_MODEL=0.35
POT_W_RATING=0.35
POT_W_FIT=0.30

# Solo para una demo SQLite dentro de Docker. No usar como configuracion
# persistente o multiinstancia de produccion.
# APP_DB_URL=sqlite:////data/demo.db
# TRAINING_DB_URL=sqlite:////data/demo.db
# ALLOW_SQLITE_IN_PRODUCTION=1
